# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# Local developer identity. Keep disabled in production.
IA_DEV_MODE=false
IA_DEV_ACCESS_TOKEN=replace-with-a-high-entropy-random-token

# Must be true when the web service is deployed behind HTTPS.
IA_COOKIE_SECURE=false
